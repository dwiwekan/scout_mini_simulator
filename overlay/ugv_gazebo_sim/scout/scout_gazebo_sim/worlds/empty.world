      <link name='gate_north'>
        <pose>10.0 6 0.5 0 0 0</pose>
        <collision name='collision'><geometry><box><size>0.2 8.0 1.0</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
