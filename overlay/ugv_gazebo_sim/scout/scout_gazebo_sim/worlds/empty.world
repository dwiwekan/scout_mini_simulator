<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- West: 20 x 20 m arena with walls, boxes and pillars (seen by the lidar), yellow curbs
         (15 cm) and orange bumps (15 cm) that block the robot.
         East (through the gate at x=10): a park with a sunken plaza (0.6 m down), rolling hills
         (up to 0.8 m, steepest 22 deg), terraces at 0.5 and 1.0 m, and ramps of 5-25 deg.
         Generated by tools/gen_empty_world.py. Origin is kept clear for spawning. -->

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky><clouds><speed>4</speed></clouds></sky>
    </scene>

    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Set world localization for GPS -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>45.15</latitude_deg>
      <longitude_deg>10.00</longitude_deg>
      <elevation>47.00</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <!-- Physics -->
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name='arena_floor'>
      <static>true</static>
      <link name='floor'>
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name='collision'><geometry><box><size>20.4 20.4 0.1</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name='visual'><geometry><box><size>20.4 20.4 0.1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name='arena_walls'>
      <static>true</static>
      <link name='north'>
        <pose>13.0 10.1 0.0 0 0 0</pose>
        <collision name='collision'><geometry><box><size>46.4 0.2 2.0</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name='visual'><geometry><box><size>46.4 0.2 2.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name='south'>
        <pose>13.0 -10.1 0.0 0 0 0</pose>
        <collision name='collision'><geometry><box><size>46.4 0.2 2.0</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name='visual'><geometry><box><size>46.4 0.2 2.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name='west'>
        <pose>-10.1 0 0.0 0 0 0</pose>
        <collision name='collision'><geometry><box><size>0.2 20.0 2.0</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name='visual'><geometry><box><size>0.2 20.0 2.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name='east'>
        <pose>36.1 0 0.0 0 0 0</pose>
        <collision name='collision'><geometry><box><size>0.2 20.0 2.0</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name='visual'><geometry><box><size>0.2 20.0 2.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
