<?xml version="1.0" ?>
<sdf version='1.7'>
  <model name='scout_mini'>
  
    <!-- Just for testing
    <joint name='world_to_base_link' type='fixed'>
      <pose relative_to='__model__'>0 0 0.5 0 0 0</pose>
      <parent>world</parent>
      <child>base_link</child>
    </joint> -->

    <!-- Base link -->
    <link name='base_link'> 
      <!-- <pose relative_to='world_to_base_link'>0 0 0 0 0 0</pose> -->

      <inertial>
        <mass>60</mass>
        <inertia>
          <ixx>2.28864</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5.10398</iyy>
          <iyz>0</iyz>
          <izz>3.43147</izz>
        </inertia>
      </inertial>
      
      <collision name='base_link_collision'>
        <!-- Box approximating scout_mini_base_link2.dae (primitive is much cheaper than a
             trimesh, and required for usable speed on heightmap terrain) -->
        <pose>0.0175 0 -0.022 0 0 0</pose>
        <geometry>
          <box>
            <size>0.561 0.39 0.182</size>
          </box>
        </geometry>
      </collision>
      
      <visual name='base_link_visual'>
        <pose>0 0 0 1.57 0 -1.57</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://scout_common/meshes/scout_mini_base_link2.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- Scout wheels -->
    <link name='rear_left_wheel_link'>
      <pose relative_to='rear_left_wheel'>0 0 0 0 0 0</pose>
      
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.7171</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.7171</iyy>
          <iyz>0</iyz>
          <izz>0.1361</izz>
        </inertia>
      </inertial>
      
      <collision name='rear_left_wheel_link_collision'>
        <!-- Cylinder approximating wheel.dae (r=0.08, w=0.132, centred 0.019 m outward along the axle) -->
        <pose>0 0 0.019 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.132</length>
          </cylinder>
        </geometry>
       <surface>
          <!-- This friction pamareter don't contain reliable data!! -->
           <friction>
            <ode>
              <!-- fdir1 = axle (link z): low sideways friction so the primitive wheels can skid-steer -->
              <mu>0.4</mu>
              <mu2>1</mu2>
              <fdir1>0 0 1</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+6</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface> 
      </collision>
      
      <visual name='rear_left_wheel_link_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://scout_common/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    
    <joint name='rear_left_wheel' type='revolute'>
      <pose relative_to='base_link'>-0.231976 0.208252 -0.099998 -1.57 0 0</pose>
      
      <parent>base_link</parent>
      <child>rear_left_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <link name='rear_right_wheel_link'>
      <pose relative_to='rear_right_wheel'>0 0 0 0 0 0</pose>
      
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.7171</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.7171</iyy>
          <iyz>0</iyz>
          <izz>0.1361</izz>
        </inertia>
      </inertial>
      
      <collision name='rear_right_wheel_link_collision'>
        <!-- Cylinder approximating wheel.dae (r=0.08, w=0.132, centred 0.019 m outward along the axle) -->
        <pose>0 0 0.019 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.132</length>
          </cylinder>
        </geometry>
        <surface>
          <!-- This friction pamareter don't contain reliable data!! -->
          <friction>
            <ode>
              <!-- fdir1 = axle (link z): low sideways friction so the primitive wheels can skid-steer -->
              <mu>0.4</mu>
              <mu2>1</mu2>
              <fdir1>0 0 1</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+6</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      
      <visual name='rear_right_wheel_link_visual'>
         <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://scout_common/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    
    <joint name='rear_right_wheel' type='revolute'>
      <pose relative_to='base_link'>-0.231976 -0.208252 -0.100998 1.57 0 0</pose>
      
      <parent>base_link</parent>
      <child>rear_right_wheel_link</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>
    
    <link name='front_right_wheel_link'>
      <pose relative_to='front_right_wheel'>0 0 0 0 0 0</pose>
      
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.7171</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.7171</iyy>
          <iyz>0</iyz>
          <izz>0.1361</izz>
        </inertia>
      </inertial>
      
      <collision name='front_right_wheel_link_collision'>
        <!-- Cylinder approximating wheel.dae (r=0.08, w=0.132, centred 0.019 m outward along the axle) -->
        <pose>0 0 0.019 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.132</length>
          </cylinder>
        </geometry>
        <surface>
          <!-- This friction pamareter don't contain reliable data!! -->
          <friction>
            <ode>
              <!-- fdir1 = axle (link z): low sideways friction so the primitive wheels can skid-steer -->
              <mu>0.4</mu>
              <mu2>1</mu2>
              <fdir1>0 0 1</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+6</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      
      <visual name='front_right_wheel_link_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://scout_common/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    
    <joint name='front_right_wheel' type='revolute'>
      <pose relative_to='base_link'>0.231976 -0.208252 -0.100998 1.57 0 0</pose>
      
      <parent>base_link</parent>
      <child>front_right_wheel_link</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>
    
    <link name='front_left_wheel_link'>
      <pose relative_to='front_left_wheel'>0 0 0 0 0 0</pose>
      
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.7171</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.7171</iyy>
          <iyz>0</iyz>
          <izz>0.1361</izz>
        </inertia>
      </inertial>
      
      <collision name='front_left_wheel_link_collision'>
        <!-- Cylinder approximating wheel.dae (r=0.08, w=0.132, centred 0.019 m outward along the axle) -->
        <pose>0 0 0.019 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.132</length>
          </cylinder>
        </geometry>
        <surface>
          <!-- This friction pamareter don't contain reliable data!! -->
          <friction>
            <ode>
              <!-- fdir1 = axle (link z): low sideways friction so the primitive wheels can skid-steer -->
              <mu>0.4</mu>
              <mu2>1</mu2>
              <fdir1>0 0 1</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+6</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      
      <visual name='front_left_wheel_link_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://scout_common/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name='front_left_wheel' type='revolute'>
      <pose relative_to='base_link'>0.231976 0.208252 -0.099998 -1.57 0 0</pose>

      <parent>base_link</parent>
      <child>front_left_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <!-- Scout plugins -->
    <plugin name='scout_mini_joint_state' filename='libgazebo_ros_joint_state_publisher.so'>
      <ros>
        <namespace>/robot_namespace</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      
      <update_rate>50</update_rate>
      
      <joint_name>front_right_wheel</joint_name>
      <joint_name>front_left_wheel</joint_name>
      <joint_name>rear_right_wheel</joint_name>
      <joint_name>rear_left_wheel</joint_name>
    </plugin>      

    <plugin name='skid_steer_drive' filename='libgazebo_ros_diff_drive.so'>
      <!-- topics & remappings -->
      <ros>
        <namespace>/robot_namespace</namespace>
        <remapping>/tf:=tf</remapping>
      </ros>
        
      <!-- Update rate -->
      <update_rate>50</update_rate>

      <!-- Number of wheel pairs -->
      <num_wheel_pairs>2</num_wheel_pairs>
        
      <!-- front wheels -->
      <left_joint>front_left_wheel</left_joint>
      <right_joint>front_right_wheel</right_joint>

      <!-- rear wheels-->
      <left_joint>rear_left_wheel</left_joint>
      <right_joint>rear_right_wheel</right_joint>

      <!-- kinematics -->
      <wheel_separation>0.490</wheel_separation>
      <wheel_separation>0.490</wheel_separation>
      <wheel_diameter>0.160</wheel_diameter>
      <wheel_diameter>0.160</wheel_diameter>
              
      <!-- limits -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <!-- output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

    <!-- Scout sensors -->
    <!-- IMU -->
    <link name="imu_link">
      <pose>0 0 0.06 0 0 0</pose>
      <inertial>
        <inertia>
          <ixx>0.000024167</ixx>
          <ixy>0.000</ixy>
          <ixz>0.000</ixz>
          <iyy>0.000024167</iyy>
          <iyz>0.000</iyz>
          <izz>0.000041667</izz>
        </inertia>
        <mass>0.1</mass>
      </inertial>

      <collision name="imu_sensor_collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>
          </box>
        </geometry>
      </collision>

      <visual name="imu_sensor_visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>
          </box>
        </geometry>
        <color rgba="0.3 0.3 0.3 1.0"/>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <orientation_reference_frame>
          <localization>"ENU"</localization>
        </orientation_reference_frame>
        
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/robot_namespace</namespace>
            <remapping>~/out:=imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </link>
    
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <!-- Livox Mid-360 (approximation): 360 deg x [-7, +52] deg, 0.1-40 m, 10 Hz.
         Uniform 360 x 16 ray grid (1 x 3.9 deg) instead of Livox's non-repetitive pattern: CPU rays
         are expensive, 720 x 32 drops the real-time factor to ~0.74, this keeps ~0.95.
         Optical centre 0.16 m above base_link (~0.34 m above ground) on a small pedestal,
         high enough that the -7 deg rays clear the ZED 2i in front of it. -->
    <link name="livox_frame">
      <pose>0.15 0 0.16 0 0 0</pose>
      <inertial>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.000</ixy>
          <ixz>0.000</ixz>
          <iyy>0.001</iyy>
          <iyz>0.000</iyz>
          <izz>0.001</izz>
        </inertia>
        <mass>0.265</mass>
      </inertial>

      <!-- no collision on the sensor body itself: rays start inside it -->
      <visual name="livox_body_visual">
        <pose>0 0 -0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.065 0.065 0.060</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <collision name="livox_pedestal_collision">
        <pose>0 0 -0.068 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.046</size>
          </box>
        </geometry>
      </collision>

      <visual name="livox_pedestal_visual">
        <pose>0 0 -0.068 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.046</size>
          </box>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>

      <sensor name="livox_mid360" type="ray">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.12414</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.12217</min_angle>
              <max_angle>0.90757</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <plugin name="livox_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/robot_namespace</namespace>
            <remapping>~/out:=livox/lidar</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>livox_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="livox_joint" type="fixed">
      <parent>base_link</parent>
      <child>livox_frame</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <!-- ZED 2i stereo camera, front of the deck, below the lidar's -7 deg cone.
         175 x 30 x 43 mm body, 0.12 m baseline, 110 deg HFOV. Simulated as a depth camera on the
         left lens (like the ZED driver, depth is registered to the left image) + the ZED's IMU.
         Topics mimic zed-ros2-wrapper: /<ns>/zed/zed/{left/image_rect_color, depth/depth_registered,
         depth/camera_info, point_cloud/cloud_registered, imu/data}. -->
    <link name="zed_camera_link">
      <pose>0.27 0 0.084 0 0 0</pose>
      <inertial>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.000</ixy>
          <ixz>0.000</ixz>
          <iyy>0.001</iyy>
          <iyz>0.000</iyz>
          <izz>0.001</izz>
        </inertia>
        <mass>0.166</mass>
      </inertial>

      <collision name="zed_collision">
        <geometry>
          <box>
            <size>0.043 0.175 0.030</size>
          </box>
        </geometry>
      </collision>

      <visual name="zed_visual">
        <geometry>
          <box>
            <size>0.043 0.175 0.030</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <visual name="zed_left_lens_visual">
        <pose>0.022 0.06 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.5 1</ambient>
          <diffuse>0.2 0.2 0.5 1</diffuse>
        </material>
      </visual>

      <visual name="zed_right_lens_visual">
        <pose>0.022 -0.06 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.5 1</ambient>
          <diffuse>0.2 0.2 0.5 1</diffuse>
        </material>
      </visual>

      <sensor name="zed2i_depth" type="depth">
        <pose>0 0.06 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <camera name="zed2i_left">
          <horizontal_fov>1.9199</horizontal_fov>
          <image>
            <width>672</width>
            <height>376</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>20.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="zed2i_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/robot_namespace/zed/zed</namespace>
            <remapping>left/image_raw:=left/image_rect_color</remapping>
            <remapping>left/depth/image_raw:=depth/depth_registered</remapping>
            <remapping>left/depth/camera_info:=depth/camera_info</remapping>
            <remapping>left/points:=point_cloud/cloud_registered</remapping>
          </ros>
          <camera_name>left</camera_name>
          <frame_name>zed_left_camera_optical_frame</frame_name>
          <hack_baseline>0.12</hack_baseline>
          <min_depth>0.3</min_depth>
          <max_depth>20.0</max_depth>
        </plugin>
      </sensor>

      <sensor name="zed2i_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <plugin name="zed2i_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/robot_namespace/zed/zed</namespace>
            <remapping>~/out:=imu/data</remapping>
          </ros>
          <frame_name>zed_imu_link</frame_name>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </link>

    <joint name="zed_joint" type="fixed">
      <parent>base_link</parent>
      <child>zed_camera_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <!-- GPS -->
    <!-- no collisions: the Livox's upward rays would hit the antenna/pole -->
    <link name="gps_link">
      <pose>-0.15 -0.125 0.3 0 0 0</pose>
      <inertial>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.000</ixy>
          <ixz>0.000</ixz>
          <iyy>0.001</iyy>
          <iyz>0.000</iyz>
          <izz>0.001</izz>
        </inertia>
        <mass>0.2</mass>
      </inertial>


      <visual name="gps_antenna_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <color rgba="0.3 0.3 0.3 1.0"/>
      </visual>


      <visual name="gps_pole_visual">
        <pose>0 0 -0.155 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.005</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
        <color rgba="0.3 0.3 0.3 1.0"/>
      </visual>

      <sensor name="gps_sensor" type="gps">
        <always_on>true</always_on>
        <update_rate>1.0</update_rate>
        
        <plugin name="gps_controller" filename="libgazebo_ros_gps_sensor.so">
            <ros>
                <namespace>/robot_namespace</namespace>
                <remapping>gps_controller/out:=gps</remapping>
                <remapping>gps_controller/vel:=gps/vel</remapping>
            </ros>
            <frame_name>gps_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="gps_joint" type="fixed">
      <parent>base_link</parent>
      <child>gps_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>
  </model>
</sdf>
