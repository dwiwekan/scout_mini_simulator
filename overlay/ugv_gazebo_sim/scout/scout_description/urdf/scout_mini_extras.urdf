<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- imu sensor -->
    <link name="imu_link">
      <visual>
        <geometry>
         <box size="0.05 0.05 0.02"/>
        </geometry>
      </visual>

      <collision>
        <geometry>
          <box size="0.05 0.05 0.02"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.1"/>
        <inertia ixx="${(0.1/12) * (0.05*0.05 + 0.02*0.02)}" ixy="0.0" ixz="0.0" iyy="${(0.1/12) * (0.05*0.05 + 0.02*0.02)}" iyz="0.0" izz="${(0.1/12) * (0.05*0.05 + 0.05*0.05)}"/>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </joint>
    
    <!-- Livox Mid-360 (livox_frame = optical centre), on a small pedestal -->
    <link name="livox_frame">
      <visual>
        <origin xyz="0 0 -0.015" rpy="0 0 0"/>
        <geometry>
          <box size="0.065 0.065 0.060"/>
        </geometry>
      </visual>

      <visual>
        <origin xyz="0 0 -0.068" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.046"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 -0.068" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.046"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.265" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <joint name="livox_joint" type="fixed">
      <parent link="base_link"/>
      <child link="livox_frame"/>
      <origin xyz="0.15 0 0.16" rpy="0 0 0"/>
    </joint>

    <!-- ZED 2i, frame names as in zed-ros2-wrapper with camera_name "zed" -->
    <link name="zed_camera_link">
      <visual>
        <geometry>
          <box size="0.043 0.175 0.030"/>
        </geometry>
      </visual>

      <collision>
        <geometry>
          <box size="0.043 0.175 0.030"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.166" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <joint name="zed_joint" type="fixed">
      <parent link="base_link"/>
      <child link="zed_camera_link"/>
      <origin xyz="0.27 0 0.084" rpy="0 0 0"/>
    </joint>

    <link name="zed_camera_center"/>
    <joint name="zed_camera_center_joint" type="fixed">
      <parent link="zed_camera_link"/>
      <child link="zed_camera_center"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="zed_left_camera_frame"/>
    <joint name="zed_left_camera_joint" type="fixed">
      <parent link="zed_camera_center"/>
      <child link="zed_left_camera_frame"/>
      <origin xyz="0 0.06 0" rpy="0 0 0"/>
    </joint>

    <link name="zed_left_camera_optical_frame"/>
    <joint name="zed_left_camera_optical_joint" type="fixed">
      <parent link="zed_left_camera_frame"/>
      <child link="zed_left_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <link name="zed_right_camera_frame"/>
    <joint name="zed_right_camera_joint" type="fixed">
      <parent link="zed_camera_center"/>
      <child link="zed_right_camera_frame"/>
      <origin xyz="0 -0.06 0" rpy="0 0 0"/>
    </joint>

    <link name="zed_right_camera_optical_frame"/>
    <joint name="zed_right_camera_optical_joint" type="fixed">
      <parent link="zed_right_camera_frame"/>
      <child link="zed_right_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <link name="zed_imu_link"/>
    <joint name="zed_imu_joint" type="fixed">
      <parent link="zed_camera_center"/>
      <child link="zed_imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- GPS sensor -->
    <link name="gps_link">
      <visual name="gps_antenna">
        <geometry>
           <cylinder length="0.02" radius="0.04"/>
        </geometry>
        <color rgba="0.3 0.3 0.3 1.0"/>
      </visual>

      <visual name="gps_pole">
        <origin xyz="0 0 -0.15" rpy="0 0 0"/>
        <geometry>
           <cylinder length="0.3" radius="0.005"/>
        </geometry>
        <color rgba="0.3 0.3 0.3 1.0"/>
      </visual>

      <collision name="gps_antenna">
        <geometry>
          <cylinder length="0.04" radius="0.02"/>
        </geometry>
      </collision>

      <collision name="gps_pole">
        <origin xyz="0 0 -0.15" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.3" radius="0.005"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.2" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <joint name="gps_joint" type="fixed">
      <parent link="base_link"/>
      <child link="gps_link"/>
      <origin xyz="-0.14 -0.1 0.3" rpy="0 0 0"/>
    </joint>
</robot>
